    function _showHoldTip(btn){
      if (!holdTooltip || !btn) return;
      const txt = (btn.getAttribute('title') || '').trim();
      if (!txt) return;
      if (_tipHideTimer) { clearTimeout(_tipHideTimer); _tipHideTimer = null; }
      holdTooltip.textContent = txt;
      holdTooltip.setAttribute('aria-hidden','false');
      holdTooltip.classList.remove('below');
      const r = btn.getBoundingClientRect();
      holdTooltip.style.left = (r.left + r.width/2) + 'px';
      holdTooltip.style.top = (r.top - 10) + 'px';
      holdTooltip.classList.add('show');
      const tr = holdTooltip.getBoundingClientRect();
      const pad = 10;
      const cx = r.left + r.width/2;
      const clampedX = Math.max(pad + tr.width/2, Math.min(window.innerWidth - pad - tr.width/2, cx));
      holdTooltip.style.left = clampedX + 'px';
      const topY = r.top - 10;
      const needsBelow = (topY - tr.height) < pad;
      if (needsBelow) {
        holdTooltip.classList.add('below');
        let y = r.bottom + 10;
        // Clamp within viewport
        const h2 = holdTooltip.getBoundingClientRect().height;
        if (y + h2 > window.innerHeight - pad) y = window.innerHeight - pad - h2;
        if (y < pad) y = pad;
        holdTooltip.style.top = y + 'px';
      }
      _tipHideTimer = setTimeout(()=>{ _hideHoldTip(); }, 1000);
