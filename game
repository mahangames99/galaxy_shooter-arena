<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>بازی تفنگی</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin:0; padding:0; height:100%; background: radial-gradient(ellipse at top, #2e1065 0%, #581c87 40%, #1e1b4b 100%); color:#e5e7eb; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
    .wrap { 
      display:flex; 
      flex-direction:column; 
      align-items:center; 
      gap:12px; 
      padding:16px; 
      position:relative; 
      max-width:100%; 
      width:100%; 
      margin:0 auto; 
      border-radius:8px; 
      border:1px solid rgba(219,39,119,0.2); 
      background: rgba(58,7,89,0.9); 
      min-height:100vh; 
    }
    
    .topbar { width:100%; max-width:100%; display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; padding:0 10px; }
    .topbar[dir="ltr"] { flex-direction: row-reverse; }
    .btn { border:none; border-radius:50%; width:46px; height:46px; padding:0; font-weight:800; cursor:pointer; color:#1e1b4b; background:linear-gradient(135deg,rgba(255,255,255,0.25),rgba(255,255,255,0.1)); backdrop-filter: blur(10px); border:1px solid rgba(255,255,255,0.3); box-shadow: 0 6px 20px rgba(139,92,246,0.3), inset 0 1px 0 rgba(255,255,255,0.5); font-size:0.85rem; display:flex; align-items:center; justify-content:center; }
    .btn:hover { background:linear-gradient(135deg,rgba(255,255,255,0.35),rgba(255,255,255,0.15)); }
    
    /* Channels Dropdown */
    .channels-dropdown {
      position: relative;
      display: inline-block;
    }
    
    /* Channels Modal - Simplified for Performance */
    .channels-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 20px;
      box-sizing: border-box;
    }
    
    .channels-modal.active {
      display: flex;
    }
    
    .channels-container {
      background: #1a202c;
      border-radius: 8px;
      padding: 20px;
      width: 100%;
      max-width: 400px;
      max-height: 80vh;
      overflow-y: auto;
      border: 1px solid #333;
    }
    
    .channels-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid #444;
    }
    
    .channels-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: #fff;
      margin: 0;
    }
    
    .close-channels {
      background: rgba(255, 255, 255, 0.1);
      border: none;
      color: #fff;
      font-size: 1.2rem;
      cursor: pointer;
      width: 32px;
      height: 32px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .close-channels:hover {
      background: rgba(255, 255, 255, 0.2);
    }
    
    .channels-menu {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }
    
    /* Modal-specific styles */
    #channelsModal .channels-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: none;
      box-shadow: none;
      padding: 0;
    }
    
    .channels-menu.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    
    .channel-option {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      background: #2d3748;
      border-radius: 6px;
      text-decoration: none;
      color: #e2e8f0;
      border: 1px solid #444;
      direction: rtl;
    }
    
    .channel-option:hover {
      background: #374151;
    }
    
    .channel-icon {
      font-size: 1.5rem;
      margin-right: 12px;
      flex-shrink: 0;
    }
    
    .channel-info {
      flex: 1;
    }
    
    .channel-name {
      font-weight: 600;
      color: #fff;
      margin: 0 0 4px 0;
    }
    
    .channel-description {
      font-size: 0.9rem;
      color: #a0aec0;
      margin: 0;
    }
    
    .channel-action {
      background: #4299e1;
      color: #fff;
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    
    .channel-action:hover {
      background: #3182ce;
    }
    
    /* Game styles continue here */
    
    .channel-icon {
      font-size: 1.8rem;
      margin-left: 16px;
      flex-shrink: 0;
      position: relative;
      z-index: 1;
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 14px;
    }
    
    .channel-info {
      flex: 1;
      position: relative;
      z-index: 1;
      padding-right: 8px;
    }
    
    .channel-name {
      margin: 0 0 6px 0;
      font-size: 1.1rem;
      font-weight: 600;
      color: #fff;
      letter-spacing: -0.3px;
      line-height: 1.3;
    }
    
    .channel-info p {
      margin: 0;
      font-size: 0.9rem;
      color: #a0aec0;
      line-height: 1.5;
      opacity: 0.9;
    }
    
    .channel-action {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      color: white;
      padding: 10px 20px;
      border-radius: 12px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      z-index: 1;
      border: none;
      box-shadow: 0 4px 15px -5px rgba(79, 70, 229, 0.4);
      white-space: nowrap;
      margin-right: 8px;
      min-width: 100px;
      text-align: center;
    }
    
    .channel-option:hover .channel-action {
      background: linear-gradient(90deg, #4338ca, #6d28d9);
      transform: translateY(-2px);
      box-shadow: 0 8px 25px -5px rgba(79, 70, 229, 0.6);
    }
    @keyframes giftPulse { 0%,100%{ box-shadow: 0 6px 20px rgba(139,92,246,0.3), inset 0 1px 0 rgba(255,255,255,0.5), 0 0 0 0 rgba(255,215,0,0.4); } 50%{ box-shadow: 0 8px 24px rgba(139,92,246,0.4), inset 0 1px 0 rgba(255,255,255,0.6), 0 0 0 8px rgba(255,215,0,0.2); } }
    .stat { background:linear-gradient(135deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05)); backdrop-filter: blur(8px); border:1px solid rgba(255,255,255,0.25); padding:6px 10px; border-radius:20px; font-weight:800; display:flex; align-items:center; gap:6px; font-size:0.85rem; box-shadow: 0 4px 12px rgba(139,92,246,0.2), inset 0 1px 0 rgba(255,255,255,0.3); }
    canvas { background: linear-gradient(180deg, #1e1b4b 0%, #312e81 50%, #2e1065 100%); border-radius:8px; box-shadow: 0 12px 28px rgba(139,92,246,0.3), inset 0 0 20px rgba(236,72,153,0.2); width:100%; max-width:100%; height:100%; max-height:calc(100vh - 120px); image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges; will-change: transform; overflow:hidden; position:relative; flex:1; }
    .hint { opacity:.8; font-size:.92rem; }
    
    /* Rain effect */
    .rain-container { position:absolute; inset:0; pointer-events:none; overflow:hidden; border-radius:8px; }
    .rain-stone { position:absolute; width:4px; height:4px; background: linear-gradient(135deg, rgba(255,255,255,0.8), rgba(200,200,255,0.6)); border-radius:50%; box-shadow: 0 0 6px rgba(255,255,255,0.4); pointer-events:none; }
    .rain-stone::before { content:'💎'; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); font-size:6px; opacity:0.8; }
    /* Diamond rain effect */
    .diamond { position:fixed; width:8px; height:8px; background: linear-gradient(135deg, #60a5fa, #3b82f6); border-radius:50%; box-shadow: 0 0 10px rgba(96,165,250,0.6), inset 0 0 4px rgba(255,255,255,0.8); pointer-events:none; z-index:100; }
    .diamond::before { content:'💎'; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); font-size:8px; opacity:0.9; text-shadow:0 0 4px rgba(255,255,255,0.8); }
    /* Toasts */
    #toastStack{ position:fixed; top:30px; left:50%; transform:translateX(-50%); display:flex; flex-direction:column; gap:8px; z-index:9999; pointer-events:none; }
    .toast{ background:linear-gradient(135deg, rgba(139,92,246,0.9), rgba(236,72,153,0.85)); color:#fff; border:1px solid rgba(255,255,255,0.2); box-shadow:0 10px 30px rgba(139,92,246,0.4), inset 0 1px 0 rgba(255,255,255,0.3); border-radius:8px; padding:10px 16px; font-weight:700; }
    .toast.show{ transform:translateY(0) scale(1); opacity:1; border-radius:8px; }
    .toast.level{ background:linear-gradient(135deg, rgba(236,72,153,0.95), rgba(219,39,119,0.9)); color:#fff; border-radius:8px; }
    .toast.boss{ background:linear-gradient(135deg, rgba(239,68,68,0.95), rgba(220,38,38,0.95)); color:#fff; border-radius:8px; }
    .toast.pause{ background:linear-gradient(135deg, rgba(139,92,246,0.9), rgba(167,139,250,0.85)); color:#fff; border-radius:8px; }
    .toast.resume{ background:linear-gradient(135deg, rgba(236,72,153,0.92), rgba(244,114,182,0.85)); color:#fff; border-radius:8px; }
    .toast.power{ background:linear-gradient(135deg, rgba(251,191,36,0.95), rgba(244,114,182,0.9)); color:#fff; border-radius:8px; }
    .toast.error{ background:linear-gradient(135deg, rgba(239,68,68,0.95), rgba(220,38,38,0.9)); color:#fff; border-radius:8px; }
    .hurt-overlay{ position:fixed; inset:0; display:flex; align-items:center; justify-content:center; font-size:96px; opacity:0; transform:scale(0.7); transition:opacity .15s ease, transform .15s ease; pointer-events:none; z-index:5000; color:#ef4444; text-shadow:0 10px 30px rgba(239,68,68,0.55); }
    .hurt-overlay.show{ opacity:1; transform:scale(1); }
    .hold-tooltip{ position:fixed; left:0; top:0; transform:translate(-50%,-100%) scale(0.98); opacity:0; transition:opacity .12s ease, transform .12s ease; pointer-events:none; z-index:6000; background:linear-gradient(135deg, rgba(255,255,255,0.28), rgba(255,255,255,0.12)); border:1px solid rgba(255,255,255,0.35); color:#111827; padding:8px 10px; border-radius:12px; box-shadow:0 10px 30px rgba(17,24,39,0.18), inset 0 1px 0 rgba(255,255,255,0.45); backdrop-filter: blur(10px); font-weight:800; font-size:0.75rem; max-width:min(260px, 80vw); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hold-tooltip.show{ opacity:1; transform:translate(-50%,-100%) scale(1); }
    .hold-tooltip.below{ transform:translate(-50%,0) scale(0.98); }
    .hold-tooltip.below.show{ transform:translate(-50%,0) scale(1); }
    /* Notification System */
    .notification { 
      position: fixed;
      top: 20px; /* Increased from 10px to 20px */
      right: 10px;
      z-index: 1100;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 6px;
      padding: 4px 8px;
      max-width: 180px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      border: 1px solid rgba(0, 0, 0, 0.08);
      opacity: 0;
      transform: translateY(-15px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      pointer-events: none;
      font-size: 0.6rem;
      line-height: 1.1;
    }
    
    .notification.show {
      opacity: 1;
      transform: translateY(0);
    }
    
    .notification .greeting {
      color: #16a34a;
      font-weight: 600;
      margin-bottom: 2px;
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 0.7rem;
    }
    
    .notification .author {
      color: #4b5563;
      font-size: 0.55rem;
      opacity: 1; /* Always show author */
      transition: opacity 0.2s ease;
      margin-top: 0;
      line-height: 1.1;
      opacity: 0.9;
    }
    
    .notification.show .author {
      opacity: 1; /* Keep author always visible */
    }
    
    @media (max-width: 768px) {
      .notification {
        right: 10px;
        left: 10px;
        max-width: calc(100% - 20px);
        font-size: 0.8rem;
      }
    }
    
    /* Enhanced Player Info Display */
    .player-info {
      position: fixed;
      /* Animations removed for better performance */
    }
    
    .player-info.hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) translateY(-30px);
    }
    
    .player-info {
      position: fixed;
      top: 110px; /* Moved down by 5 more pixels */
      left: 50%;
      transform: translateX(-50%) scale(0.9); /* Increased scale from 0.8 to 0.9 */
      transform-origin: top center;
      background: linear-gradient(135deg, 
        rgba(15, 23, 42, 0.95) 0%, 
        rgba(30, 41, 59, 0.92) 50%, 
        rgba(15, 23, 42, 0.95) 100%);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-radius: 0 0 8px 8px; /* Slightly larger border radius */
      padding: 3px 12px 4px 12px; /* Increased padding */
      font-size: 0.65rem; /* Slightly larger font */
      font-weight: 600;
      color: #fff;
      box-shadow: 
        0 3px 12px rgba(0, 0, 0, 0.25),
        0 1px 6px rgba(0, 0, 0, 0.1),
        inset 0 1px 1px rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-top: none;
      z-index: 9999;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px; /* Slightly larger gap */
      min-width: auto;
      width: auto;
      opacity: 0.98;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      border-bottom: 2px solid rgba(139, 92, 246, 0.6);
      position: fixed;
      overflow: hidden;
    }
    
    .player-info::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.08),
        transparent
      );
      pointer-events: none;
    }
    
        
    .player-info:hover {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.4), 
                  inset 0 1px 1px rgba(255, 255, 255, 0.15);
      border-top-color: rgba(96, 165, 250, 0.5);
      border-bottom-color: rgba(139, 92, 246, 0.5);
    }
    .player-stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      padding: 2px 8px;
      min-width: 55px;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      border-radius: 10px;
      background: linear-gradient(135deg, 
        rgba(255, 255, 255, 0.05) 0%, 
        rgba(255, 255, 255, 0.02) 50%, 
        rgba(255, 255, 255, 0.05) 100%);
      box-shadow: 
        inset 0 1px 2px rgba(255, 255, 255, 0.08),
        inset 0 -1px 2px rgba(0, 0, 0, 0.05),
        0 2px 6px rgba(0, 0, 0, 0.08);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    
    .player-stat:hover {
      background: linear-gradient(135deg, 
        rgba(255, 255, 255, 0.08) 0%, 
        rgba(255, 255, 255, 0.04) 50%, 
        rgba(255, 255, 255, 0.08) 100%);
      transform: translateY(-1px) scale(1.02);
      box-shadow: 
        inset 0 1px 2px rgba(255, 255, 255, 0.1),
        inset 0 -1px 2px rgba(0, 0, 0, 0.08),
        0 4px 16px rgba(0, 0, 0, 0.15);
    }
    
    .player-stat:not(:last-child)::after {
      content: '';
      position: absolute;
      right: -14px;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 50%;
      background: linear-gradient(to bottom, 
        transparent, 
        rgba(255, 255, 255, 0.15), 
        transparent);
      opacity: 0.5;
    }
    
    .stat-value {
      font-size: 1rem;
      font-weight: 700;
      background: linear-gradient(135deg, 
        #e0f2fe 0%, 
        #bae6fd 25%, 
        #7dd3fc 50%, 
        #38bdf8 75%, 
        #0ea5e9 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 1px 3px rgba(96, 165, 250, 0.15);
      margin-bottom: 1px;
      white-space: nowrap;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 20px;
      line-height: 1.1;
    }
    
    .stat-value::before {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, #60a5fa, #8b5cf6);
      transition: width 0.3s ease;
    }
    
    .player-stat:hover .stat-value::before {
      width: 100%;
    }
    
    .stat-label {
      font-size: 0.6rem; /* Slightly smaller */
      font-weight: 600; /* Slightly reduced weight */
      color: #cbd5e1; /* Lighter color */
      text-transform: uppercase;
      letter-spacing: 0.05em; /* Slightly reduced */
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
      position: relative;
      padding: 1px 6px; /* Reduced padding */
      border-radius: 6px;
      background: linear-gradient(135deg, 
        rgba(0, 0, 0, 0.25) 0%, 
        rgba(0, 0, 0, 0.15) 50%, 
        rgba(0, 0, 0, 0.25) 100%);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      border: 1px solid rgba(255, 255, 255, 0.04);
    }
    
    .player-stat:hover .stat-label {
      color: #f1f5f9; /* Lighter on hover */
      background: linear-gradient(135deg, 
        rgba(0, 0, 0, 0.35) 0%, 
        rgba(0, 0, 0, 0.2) 50%, 
        rgba(0, 0, 0, 0.35) 100%);
      transform: translateY(0.5px) scale(1.02);
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    }
    
    .player-name-display {
      font-size: 1.2rem;
      font-weight: 800;
      background: linear-gradient(135deg, #7dd3fc, #60a5fa);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 2px 8px rgba(96, 165, 250, 0.4);
      position: relative;
      padding: 0 12px 4px;
      transition: all 0.3s ease;
      letter-spacing: 0.5px;
    }
    
    .player-stat:hover .player-name-display {
      text-shadow: 0 4px 12px rgba(96, 165, 250, 0.6);
      transform: translateY(-1px);
    }
    
    .player-name-display::before {
      content: '👤';
      position: absolute;
      left: -8px;
      top: 50%;
      transform: translate(-100%, -50%) scale(1);
      font-size: 1rem;
      opacity: 0.7;
      transition: all 0.3s ease;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    }
    
    .player-stat:hover .player-name-display::before {
      transform: translate(-100%, -50%) scale(1.1);
      opacity: 1;
    }
    
    .player-score-display .stat-value {
      background: linear-gradient(135deg, #a5f3fc, #38bdf8);
      -webkit-background-clip: text;
      background-clip: text;
      text-shadow: 0 2px 8px rgba(56, 189, 248, 0.4);
    }
    
    .player-score-display:hover .stat-value {
      text-shadow: 0 4px 12px rgba(56, 189, 248, 0.6);
    }
    
    .player-level-display {
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.9), rgba(245, 158, 11, 0.8));
      padding: 8px 16px;
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 700;
      color: #1e1b4b;
      box-shadow: 0 4px 16px rgba(251, 191, 36, 0.4);
      display: flex;
      align-items: center;
      gap: 8px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    
    .player-level-display::before {
      content: '⭐';
      font-size: 1rem;
      opacity: 0.9;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }
    
    .player-level-display:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(251, 191, 36, 0.5);
    }
    
    .player-level-display:hover::before {
      transform: rotate(15deg) scale(1.2);
    }
    
    .player-diamonds-display {
      background: linear-gradient(135deg, rgba(79, 70, 229, 0.9), rgba(124, 58, 237, 0.9));
      padding: 6px 12px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      color: white;
      box-shadow: 0 4px 12px rgba(124, 58, 237, 0.4);
      display: flex;
      align-items: center;
      gap: 6px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    
    .player-diamonds-display::before {
      content: '💎';
      font-size: 1rem;
      opacity: 0.9;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
      filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.5));
    }
    
    .player-diamonds-display:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(124, 58, 237, 0.6);
    }
    
    @keyframes diamondShine {
      0%, 100% { transform: scale(1) rotate(0deg); }
      25% { transform: scale(1.1) rotate(5deg); }
      50% { transform: scale(1.15) rotate(0deg); }
