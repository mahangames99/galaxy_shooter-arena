    function updateDiamonds() {
      for (let i = diamonds.length - 1; i >= 0; i--) {
        const d = diamonds[i];
        d.y += d.vy;
        d.x += d.vx;
        
        // Convert canvas coordinates to screen coordinates for display
        const canvasRect = canvas.getBoundingClientRect();
        const screenX = canvasRect.left + (d.x / W) * canvasRect.width;
        const screenY = canvasRect.top + (d.y / H) * canvasRect.height;
        
        d.element.style.left = screenX + 'px';
        d.element.style.top = screenY + 'px';
        
        // Check collision with player - use canvas coordinates
        const dx = d.x - player.x;
        const dy = d.y - player.y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < player.r + 15) { // Larger collection radius for diamonds
          // Collect diamond
          state.diamonds += 1;
          if (diamondsEl) diamondsEl.textContent = state.diamonds;
          try{ localStorage.setItem('gameDiamonds', String(state.diamonds)); }catch(e){}
          Sound.play('coin');
          // Special effect for diamond collection
          addParticles(d.x, d.y, '#60a5fa');
          addParticles(d.x, d.y, '#3b82f6');
          addParticles(d.x, d.y, '#1d4ed8');
          // Show special message
          showToast('💎 +1 الماس!', 'power');
          d.element.remove();
          diamonds.splice(i, 1);
          continue;
        }
        
        // Remove if out of bounds
        if (d.y < -50 || d.y > window.innerHeight + 50 || 
            d.x < -50 || d.x > window.innerWidth + 50) {
          d.element.remove();
          diamonds.splice(i, 1);
        }
      }
    }
    
