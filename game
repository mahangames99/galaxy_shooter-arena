    }

    // Day/night cycle variables
    let celestialState = 'sun'; // 'sun' or 'moon'
    let celestialTransition = 0; // 0-1, for smooth transitions
    let celestialTimer = 0;
    let celestialX = 0; // Current X position
    let celestialY = 0; // Current Y position
    const CELESTIAL_CYCLE_TIME = 2400; // 40 seconds at 60 FPS
    const TWO_PI = Math.PI * 2;
    const SUN_PATH = { radiusX: 0.48, radiusY: 0.58, baseY: 0.88 };
    const MOON_PATH = { radiusX: 0.48, radiusY: 0.48, baseY: 0.86 };
    
    // Sky colors for different times of day
    const DAY_SKY = { r: 125, g: 195, b: 225 }; // Softened blue sky
    const NIGHT_SKY = { r: 10, g: 10, b: 30 };   // Dark blue/black night sky
    const SUNRISE_SKY = { r: 230, g: 188, b: 168 }; // Gentle warm tone
    const SUNSET_SKY = { r: 40, g: 55, b: 110 }; // Deep blue/purple

    function drawBG(){
      ctx.clearRect(0,0,W,H);
      
      // Update celestial cycle
      celestialTimer = (celestialTimer + 1) % CELESTIAL_CYCLE_TIME;
      
      // Calculate celestial position (0 to 2π)
      const celestialProgress = (celestialTimer / CELESTIAL_CYCLE_TIME) * TWO_PI;
      const normalizedAngle = (celestialProgress % TWO_PI + TWO_PI) % TWO_PI;
      const sunHeight = Math.sin(celestialProgress);
      const isDay = sunHeight > 0;
      
      // Calculate sky color based on celestial position
      let skyColor;
      
      if (sunHeight > 0.7) {
        // Midday - bright blue sky
        const t = (sunHeight - 0.7) / 0.3;
        skyColor = {
          r: Math.round(SUNRISE_SKY.r * (1-t) + DAY_SKY.r * t),
          g: Math.round(SUNRISE_SKY.g * (1-t) + DAY_SKY.g * t),
          b: Math.round(SUNRISE_SKY.b * (1-t) + DAY_SKY.b * t)
        };
      } else if (sunHeight > 0.4) {
        // Morning/Evening - sunrise/sunset colors
        const t = (sunHeight - 0.4) / 0.3;
        skyColor = {
          r: Math.round(SUNSET_SKY.r * (1-t) + SUNRISE_SKY.r * t),
          g: Math.round(SUNSET_SKY.g * (1-t) + SUNRISE_SKY.g * t),
          b: Math.round(SUNSET_SKY.b * (1-t) + SUNRISE_SKY.b * t)
        };
      } else if (sunHeight > -0.4) {
        // Night - dark blue to black
        const t = (sunHeight + 0.4) / 0.8;
        skyColor = {
          r: Math.round(NIGHT_SKY.r * (1-t) + SUNSET_SKY.r * t),
          g: Math.round(NIGHT_SKY.g * (1-t) + SUNSET_SKY.g * t),
          b: Math.round(NIGHT_SKY.b * (1-t) + 100 * t)
        };
      } else {
        // Deep night
        skyColor = { ...NIGHT_SKY };
      }
      
      // Apply sky color
      ctx.fillStyle = `rgb(${skyColor.r}, ${skyColor.g}, ${skyColor.b})`;
      ctx.fillRect(0, 0, W, H);
      
      // Determine celestial body location (corner-based path)
      let heightFactor = 0;
      if (isDay) {
        const dayAngle = normalizedAngle; // 0 (sunrise) -> π (sunset)
        const theta = Math.PI - dayAngle;
        celestialX = W / 2 + Math.cos(theta) * (W * SUN_PATH.radiusX);
        celestialY = H * SUN_PATH.baseY - Math.sin(theta) * (H * SUN_PATH.radiusY);
        heightFactor = Math.max(0, Math.sin(dayAngle));
      } else {
        const nightAngle = normalizedAngle - Math.PI; // 0 (moonrise) -> π (moonset)
        const clampedNightAngle = Math.max(0, Math.min(Math.PI, nightAngle));
        const theta = clampedNightAngle;
        celestialX = W / 2 + Math.cos(theta) * (W * MOON_PATH.radiusX);
        celestialY = H * MOON_PATH.baseY - Math.sin(theta) * (H * MOON_PATH.radiusY);
        heightFactor = Math.max(0, Math.sin(clampedNightAngle));
      }
      
      celestialState = isDay ? 'sun' : 'moon';
      celestialTransition = heightFactor; // 0 near corners, 1 near top
      
      // Draw stars (more visible at night)
      ctx.save();
      const starIntensity = isDay
        ? 1 - Math.max(0, Math.min(1, heightFactor * 1.4))
        : 0.6 + (1 - heightFactor) * 0.4;
      const starAlpha = 0.1 + starIntensity * 0.4; // 0.1-0.5
      const starCount = Math.floor(100 * gfxFactor * (perfLow ? 0.7 : 1));
      
      // Twinkling effect for some stars
      const twinkle = Math.sin(state.time * 0.1) * 0.5 + 0.5;
      
      // Draw dimmer stars first
      ctx.globalAlpha = starAlpha * 0.7;
      ctx.fillStyle = '#93c5fd';
      for (let i = 0; i < starCount; i++) {
        const x = (i * 57 + state.time * 0.3) % W;
        const y = (i * 73 + 40) % H;
        const size = 1 + Math.random() * 1.5;
        ctx.fillRect(x, y, size, size);
      }
      
      // Draw brighter twinkling stars
      ctx.globalAlpha = starAlpha * (0.5 + twinkle * 0.5);
      ctx.fillStyle = '#ffffff';
      for (let i = 0; i < starCount / 2; i++) {
        const x = (i * 79 + state.time * 0.2) % W;
        const y = (i * 93 + 80) % H;
        const size = 1.5 + Math.random();
        ctx.fillRect(x, y, size, size);
      }
      
      const celestialSize = 30;
      
      // Draw celestial body (sun or moon)
      if (celestialState === 'sun') {
        // Draw sun with glow
        const sunAlpha = Math.min(1, celestialTransition * 1.5);
        ctx.globalAlpha = sunAlpha;
        
        // Sun glow
        const gradient = ctx.createRadialGradient(
          celestialX, celestialY, celestialSize * 0.5,
          celestialX, celestialY, celestialSize * 3
        );
        gradient.addColorStop(0, 'rgba(255, 230, 100, 0.8)');
        gradient.addColorStop(1, 'rgba(255, 100, 50, 0)');
        
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(celestialX, celestialY, celestialSize * 3, 0, Math.PI * 2);
        ctx.fill();
        
        // Sun body
        ctx.fillStyle = '#ffde3b';
        ctx.shadowColor = '#ffde3b';
        ctx.shadowBlur = 20;
        ctx.beginPath();
        ctx.arc(celestialX, celestialY, celestialSize, 0, Math.PI * 2);
        ctx.fill();
        
        // Sun rays (only when high in the sky)
        if (celestialTransition > 0.7) {
          ctx.strokeStyle = 'rgba(255, 230, 100, 0.6)';
          ctx.lineWidth = 2;
          const rayCount = 12;
          const rayLength = celestialSize * 1.5;
          
          for (let i = 0; i < rayCount; i++) {
            const angle = (i / rayCount) * Math.PI * 2;
            const startR = celestialSize * 1.1;
            const endR = celestialSize + rayLength;
            
            ctx.beginPath();
            ctx.moveTo(
              celestialX + Math.cos(angle) * startR,
              celestialY + Math.sin(angle) * startR
            );
            ctx.lineTo(
              celestialX + Math.cos(angle) * endR,
              celestialY + Math.sin(angle) * endR
            );
            ctx.stroke();
          }
        }
      } else {
        // Draw moon with image
        const moonAlpha = Math.min(0.9, (1 - celestialTransition) * 1.2);
        ctx.globalAlpha = moonAlpha;
        
        // Create moon image if not already created
        if (!window.moonImage) {
          window.moonImage = new Image();
          window.moonImage.crossOrigin = 'Anonymous'; // Handle CORS if needed
          window.moonImage.src = 'moon-600x352.webp';
        }
        
        // Reduced brightness moon glow
        const glowGradient = ctx.createRadialGradient(
          celestialX, celestialY, celestialSize * 0.5,
          celestialX, celestialY, celestialSize * 2.5  // Reduced glow radius
        );
        glowGradient.addColorStop(0, 'rgba(180, 190, 210, 0.5)');  // Darker and more transparent
        glowGradient.addColorStop(0.7, 'rgba(140, 160, 190, 0.2)');  // Darker and more transparent
        glowGradient.addColorStop(1, 'rgba(80, 100, 130, 0)');  // Darker end color
        
        // Draw glow
        ctx.fillStyle = glowGradient;
        ctx.beginPath();
        ctx.arc(celestialX, celestialY, celestialSize * 3.5, 0, Math.PI * 2);
        ctx.fill();
        
        // Draw moon image if loaded, otherwise show placeholder
        if (window.moonImage.complete && window.moonImage.naturalWidth !== 0) {
          // Increase moon size for better visibility
          const imgSize = celestialSize * 3.0;
          
          // Draw outer glow
          const outerGlow = ctx.createRadialGradient(
            celestialX, celestialY, imgSize/2 * 0.8,
            celestialX, celestialY, imgSize/2 * 1.2
          );
          outerGlow.addColorStop(0, 'rgba(255, 255, 255, 0.6)');
          outerGlow.addColorStop(1, 'rgba(200, 220, 255, 0)');
          
          ctx.fillStyle = outerGlow;
          ctx.beginPath();
          ctx.arc(celestialX, celestialY, imgSize/2 * 1.2, 0, Math.PI * 2);
          ctx.fill();
          
          // Save context for clipping
          ctx.save();
          
          // Create a circular clipping path
          ctx.beginPath();
          ctx.arc(celestialX, celestialY, imgSize/2, 0, Math.PI * 2);
          ctx.closePath();
          ctx.clip();
          
          // Draw the moon image with enhanced brightness and contrast
          ctx.globalCompositeOperation = 'source-over';
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          
          // Draw the moon image
          ctx.drawImage(
            window.moonImage, 
            celestialX - imgSize/2, 
            celestialY - imgSize/2, 
            imgSize, 
            imgSize
          );
          
          // Add a subtle overlay to enhance details
          ctx.globalCompositeOperation = 'overlay';
          ctx.fillStyle = 'rgba(255, 255, 255, 0.1)';
          ctx.fillRect(celestialX - imgSize/2, celestialY - imgSize/2, imgSize, imgSize);
          
          // Restore the context to remove clipping
          ctx.restore();
          
          // Add a subtle outer glow
          if (moonAlpha > 0.3) {
            const outerGlow = ctx.createRadialGradient(
              celestialX, celestialY, imgSize/2 * 0.9,
              celestialX, celestialY, imgSize/2 * 1.5
            );
            outerGlow.addColorStop(0, 'rgba(200, 220, 255, 0.4)');
            outerGlow.addColorStop(1, 'rgba(100, 150, 255, 0)');
            
            ctx.fillStyle = outerGlow;
            ctx.beginPath();
            ctx.arc(celestialX, celestialY, imgSize/2 * 1.5, 0, Math.PI * 2);
            ctx.fill();
          }
        } else {
          // Fallback circle if image not loaded yet
          ctx.fillStyle = '#f0f0f0';
          ctx.shadowColor = '#f0f0f0';
          ctx.shadowBlur = 15;
          ctx.beginPath();
          ctx.arc(celestialX, celestialY, celestialSize, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }
      
      ctx.shadowBlur = 0;
      
      // Atmospheric effects based on time of day
      ctx.globalAlpha = 0.25;
      
      // Daytime atmospheric scattering
      if (celestialState === 'sun' && celestialTransition > 0.6) {
        // Sunlight scattering
        const sunX = celestialX / W;
        const sunY = celestialY / H;
        const gradient = ctx.createRadialGradient(
          W * sunX, H * sunY, 0,
          W * sunX, H * sunY, Math.max(W, H) * 0.8
        );
        
        // Warmer colors when sun is low, whiter when high
        const sunHeight = Math.max(0, sunY);
        const r = 255 - (255 - 255) * sunHeight;
        const g = 230 - (230 - 200) * sunHeight;
        const b = 180 - (180 - 150) * sunHeight;
        
        gradient.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0.35)`);
        gradient.addColorStop(0.7, `rgba(255, 255, 255, 0.08)`);
        gradient.addColorStop(1, 'rgba(2,6,23,0)');
        
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, W, H);
      }
      
      // Nighttime atmospheric glow
      if (celestialState === 'moon' && celestialTransition > 0.3) {
        // Moonlight glow
        const moonX = celestialX / W;
        const moonY = celestialY / H;
        const gradient = ctx.createRadialGradient(
          W * moonX, H * moonY, 0,
          W * moonX, H * moonY, Math.max(W, H) * 0.6
        );
        
        gradient.addColorStop(0, 'rgba(150, 180, 255, 0.3)');
        gradient.addColorStop(0.8, 'rgba(100, 120, 200, 0.1)');
        gradient.addColorStop(1, 'rgba(0, 0, 20, 0)');
        
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, W, H);
      }
      
      // Horizon glow at sunrise/sunset
      if (Math.abs(sunHeight) < 0.3) {
        const horizonGradient = ctx.createLinearGradient(0, H * 0.7, 0, H);
        const intensity = (0.3 - Math.abs(sunHeight)) / 0.3;
        
        if (isDay) {
          // Warm sunset colors
          horizonGradient.addColorStop(0, `rgba(255, 150, 100, ${0.3 * intensity})`);
          horizonGradient.addColorStop(1, 'rgba(0,0,0,0)');
        } else {
          // Cool moonlit horizon
          horizonGradient.addColorStop(0, `rgba(100, 150, 255, ${0.2 * intensity})`);
          horizonGradient.addColorStop(1, 'rgba(0,0,0,0)');
        }
        
        ctx.fillStyle = horizonGradient;
        ctx.fillRect(0, H * 0.7, W, H * 0.3);
      }
      
      ctx.globalAlpha = 1;
      ctx.restore();
    }

    function drawEnemies(){
      enemies.forEach(e=>{
        ctx.save();
        
        if (e.triangle) {
          // Draw green triangle enemy
          ctx.fillStyle = '#22c55e';
          ctx.shadowColor = '#22c55e';
          ctx.shadowBlur = Math.max(0, Math.round(16*gfxFactor*(perfLow?0.6:1)));
          
          // Draw triangle pointing downward
          ctx.beginPath();
          ctx.moveTo(e.x, e.y + e.r); // Bottom point
          ctx.lineTo(e.x - e.r, e.y - e.r); // Top left
          ctx.lineTo(e.x + e.r, e.y - e.r); // Top right
          ctx.closePath();
          ctx.fill();
          ctx.shadowBlur = 0;
        } else if (e.square) {
          // Draw square enemy
          ctx.fillStyle = '#8b5cf6';
          ctx.shadowColor = '#8b5cf6';
          ctx.shadowBlur = Math.max(0, Math.round(16*gfxFactor*(perfLow?0.6:1)));
          
          // Draw square
          ctx.fillRect(e.x - e.r, e.y - e.r, e.r * 2, e.r * 2);
          ctx.shadowBlur = 0;
        } else {
          // Draw normal circular enemy
          ctx.fillStyle = e.elite ? '#f59e0b' : '#ef4444';
          ctx.shadowColor = e.elite ? '#f59e0b' : '#ef4444';
          ctx.shadowBlur = Math.max(0, Math.round((e.elite?20:16)*gfxFactor*(perfLow?0.6:1)));
          ctx.beginPath(); ctx.arc(e.x, e.y, e.r, 0, Math.PI*2); ctx.fill();
          ctx.shadowBlur = 0;
          
          // HP bar for elite
          if (e.elite){
            const maxHp = 4 + Math.min(4, Math.floor(state.level/3));
            const hpRatio = e.hp / maxHp;
            ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.fillRect(e.x - e.r, e.y - e.r - 8, e.r*2, 4);
            ctx.fillStyle = '#10b981'; ctx.fillRect(e.x - e.r, e.y - e.r - 8, e.r*2*hpRatio, 4);
          }
        }
        
        ctx.restore();
      });
      // Boss
      if (boss){
        ctx.save();
        ctx.fillStyle = '#dc2626'; ctx.shadowColor = '#dc2626'; ctx.shadowBlur = Math.max(0, Math.round(32*gfxFactor));
        ctx.beginPath(); ctx.arc(boss.x, boss.y, boss.r, 0, Math.PI*2); ctx.fill();
        ctx.shadowBlur = 0;
        // Boss HP bar
        const hpRatio = boss.hp / boss.maxHp;
        const barW = 200; const barH = 12;
        ctx.fillStyle = 'rgba(0,0,0,0.6)'; ctx.fillRect(W/2 - barW/2, 20, barW, barH);
        ctx.fillStyle = '#ef4444'; ctx.fillRect(W/2 - barW/2, 20, barW*hpRatio, barH);
        ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.strokeRect(W/2 - barW/2, 20, barW, barH);
        ctx.fillStyle = '#fff'; ctx.font = 'bold 16px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText((tmap[document.documentElement.lang]||tmap.fa).bossLabel || 'BOSS', W/2, 50);
        ctx.restore();
      }
    }

    function drawBullets(){
      const skinObj = skins.find(s=>s.id===selectedSkin) || skins[0];
      bullets.forEach(b=>{
        const g = ctx.createLinearGradient(b.x, b.y, b.x, b.y+10);
        const c0 = (skinObj.bullet && skinObj.bullet[0]) || '#fecaca';
        const c1 = (skinObj.bullet && skinObj.bullet[1]) || '#ef4444';
        g.addColorStop(0,c0); g.addColorStop(1,c1);
        ctx.save();
        ctx.shadowColor = c1; ctx.shadowBlur = Math.max(0, Math.round(10*gfxFactor));
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(b.x,b.y,b.r,0,Math.PI*2); ctx.fill();
        // longer trail with gradient
        const baseTrail = slowMo > 0 ? 22 : 14;
        const trailLen = Math.max(8, Math.round(baseTrail * gfxFactor + (slowMo>0?6:0)));
        const tg = ctx.createLinearGradient(b.x, b.y, b.x, b.y+trailLen);
        tg.addColorStop(0, c1); tg.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.globalAlpha = 0.5; ctx.strokeStyle = tg; ctx.lineWidth = Math.max(1, Math.round(2*gfxFactor)); ctx.beginPath(); ctx.moveTo(b.x, b.y); ctx.lineTo(b.x, b.y+trailLen); ctx.stroke(); ctx.globalAlpha = 1;
        ctx.restore();
      });
    }

    function drawPlayer(){
      const skinObj = skins.find(s=>s.id===selectedSkin) || skins[0];
      ctx.save();
      // shield visual
      if (shield > 0){
        ctx.globalAlpha = 0.3 + Math.sin(state.time*0.15)*0.15;
        ctx.strokeStyle = '#3b82f6'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(player.x, player.y, player.r + 8, 0, Math.PI*2); ctx.stroke();
        ctx.globalAlpha = 1;
      }
      // body with glow
      ctx.fillStyle = skinObj.color;
      ctx.shadowColor = skinObj.color;
      ctx.shadowBlur = Math.max(0, Math.round(12*gfxFactor*(perfLow?0.7:1)));
      
      // Draw shape based on skin
      const shape = skinObj.shape || 'circle';
      if (shape === 'square') {
        const size = player.r * 2;
        ctx.fillRect(player.x - size/2, player.y - size/2, size, size);
      } else if (shape === 'triangle') {
        ctx.beginPath();
        ctx.moveTo(player.x, player.y - player.r);
        ctx.lineTo(player.x - player.r, player.y + player.r);
        ctx.lineTo(player.x + player.r, player.y + player.r);
        ctx.closePath();
        ctx.fill();
      } else if (shape === 'star') {
        const spikes = 5;
        const outerRadius = player.r;
        const innerRadius = player.r * 0.5;
        ctx.beginPath();
        for (let i = 0; i < spikes * 2; i++) {
          const radius = i % 2 === 0 ? outerRadius : innerRadius;
          const angle = (i * Math.PI) / spikes - Math.PI / 2;
          const x = player.x + Math.cos(angle) * radius;
          const y = player.y + Math.sin(angle) * radius;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.fill();
      } else if (shape === 'hexagon') {
        const size = player.r;
        ctx.beginPath();
        for (let i = 0; i < 6; i++) {
          const angle = (Math.PI / 3) * i;
          const x = player.x + Math.cos(angle) * size;
          const y = player.y + Math.sin(angle) * size;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.fill();
      } else if (shape === 'diamond') {
        ctx.beginPath();
        ctx.moveTo(player.x, player.y - player.r);
        ctx.lineTo(player.x + player.r, player.y);
        ctx.lineTo(player.x, player.y + player.r);
        ctx.lineTo(player.x - player.r, player.y);
        ctx.closePath();
        ctx.fill();
      } else {
        ctx.beginPath(); ctx.arc(player.x, player.y, player.r, 0, Math.PI*2); ctx.fill();
      }
      ctx.shadowBlur = 0;
      // barrel
      ctx.fillStyle = '#e5e7eb';
      ctx.fillRect(player.x-4, player.y-player.r-16-recoil, 8, 18);
      // small thruster flicker
      ctx.globalAlpha = 0.7; ctx.fillStyle = 'rgba(251,191,36,0.9)';
      ctx.beginPath(); ctx.moveTo(player.x-6, player.y+player.r-2); ctx.lineTo(player.x+6, player.y+player.r-2); ctx.lineTo(player.x, player.y+player.r+6+Math.random()*4); ctx.closePath(); ctx.fill();
      ctx.globalAlpha = 1;
      // enhanced muzzle flash
      if (muzzle>0){
        const a = Math.min(1, muzzle/8);
        ctx.globalCompositeOperation = 'lighter';
        ctx.globalAlpha = a; ctx.fillStyle = '#fde047';
        ctx.beginPath(); ctx.arc(player.x, player.y-player.r-22-recoil, 6+muzzle*0.6, 0, Math.PI*2); ctx.fill();
        // rays
        ctx.strokeStyle = 'rgba(253,224,71,0.9)'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(player.x, player.y-player.r-22-recoil); ctx.lineTo(player.x, player.y-player.r-32-recoil);
        ctx.moveTo(player.x-4, player.y-player.r-20-recoil); ctx.lineTo(player.x-10, player.y-player.r-28-recoil);
        ctx.moveTo(player.x+4, player.y-player.r-20-recoil); ctx.lineTo(player.x+10, player.y-player.r-28-recoil);
        ctx.stroke(); ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
      }
      ctx.restore();
    }

    function drawParticles(){
      particles.forEach(p=>{ ctx.globalAlpha = Math.max(0, p.life/28); ctx.fillStyle = p.color; ctx.fillRect(p.x,p.y,2,2); ctx.globalAlpha = 1; });
    }

    function updateRings(){
      const cap = Math.floor(40 * gfxFactor) + 10;
      for (let i=rings.length-1;i>=0;i--){ const k=rings[i]; k.r += 2.2; k.a *= 0.93; if (k.r>k.max || k.a<0.05) rings.splice(i,1); }
      if (rings.length > cap) rings.splice(0, rings.length - cap);
    }

    function drawRings(){
      rings.forEach(k=>{ ctx.globalAlpha = k.a; ctx.strokeStyle = k.color + k.a + ')'; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(k.x, k.y, k.r, 0, Math.PI*2); ctx.stroke(); ctx.globalAlpha = 1; });
    }

    function drawPowerups(){
      powerups.forEach(p=>{
        ctx.save();
        const pulse = Math.sin(p.t*0.15)*0.3 + 1;
        ctx.globalAlpha = 0.9;
        if (p.type==='shield'){ ctx.fillStyle = '#3b82f6'; ctx.strokeStyle = '#60a5fa'; }
        else if (p.type==='triple'){ ctx.fillStyle = '#f59e0b'; ctx.strokeStyle = '#fbbf24'; }
        else if (p.type==='magnet'){ ctx.fillStyle = '#10b981'; ctx.strokeStyle = '#34d399'; }
        ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(p.x, p.y, p.r*pulse, 0, Math.PI*2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fff'; ctx.font = 'bold 16px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        const icon = p.type==='shield'?'🛡️':p.type==='triple'?'⚡':'🧲';
        ctx.fillText(icon, p.x, p.y);
        ctx.globalAlpha = 1; ctx.restore();
      });
    }

    function drawHUD(){
      ctx.save();
      // Combo display
      if (combo > 0){
        const mult = Math.min(5, 1 + Math.floor(combo/5)*0.5);
        ctx.fillStyle = combo >= 10 ? '#fde047' : '#60a5fa';
        ctx.font = 'bold 24px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(`${combo}x COMBO (${mult.toFixed(1)}x)`, W/2, 70); // Moved 30px lower
      }
      // Power-up indicators (vertical display)
      let offsetY = 20;
      const barWidth = 8;
      const barHeight = 60;
      
      if (shield > 0){
        const shieldHeight = Math.min(barHeight, (shield/300) * barHeight);
        ctx.fillStyle = '#3b82f6'; ctx.fillRect(20, offsetY + (barHeight - shieldHeight), barWidth, shieldHeight);
        ctx.fillStyle = '#fff'; ctx.font = 'bold 14px sans-serif'; ctx.textAlign = 'center'; ctx.fillText('🛡️', 24, offsetY - 5);
        ctx.fillStyle = '#3b82f6'; ctx.font = '12px sans-serif'; ctx.fillText(Math.ceil(shield/60) + 's', 24, offsetY + barHeight + 15);
        offsetY += barHeight + 30;
      }
      if (tripleShot > 0){
        const tripleHeight = Math.min(barHeight, (tripleShot/400) * barHeight);
        ctx.fillStyle = '#f59e0b'; ctx.fillRect(20, offsetY + (barHeight - tripleHeight), barWidth, tripleHeight);
        ctx.fillStyle = '#fff'; ctx.font = 'bold 14px sans-serif'; ctx.textAlign = 'center'; ctx.fillText('⚡', 24, offsetY - 5);
        ctx.fillStyle = '#f59e0b'; ctx.font = '12px sans-serif'; ctx.fillText(Math.ceil(tripleShot/80) + 's', 24, offsetY + barHeight + 15);
        offsetY += barHeight + 30;
      }
      if (magnet > 0){
        const magnetHeight = Math.min(barHeight, (magnet/500) * barHeight);
        ctx.fillStyle = '#10b981'; ctx.fillRect(20, offsetY + (barHeight - magnetHeight), barWidth, magnetHeight);
        ctx.fillStyle = '#fff'; ctx.font = 'bold 14px sans-serif'; ctx.textAlign = 'center'; ctx.fillText('🧲', 24, offsetY - 5);
        ctx.fillStyle = '#10b981'; ctx.font = '12px sans-serif'; ctx.fillText(Math.ceil(magnet/100) + 's', 24, offsetY + barHeight + 15);
      }
      ctx.restore();
    }

    function score(n){
      state.score += n;
      scoreEl.textContent = state.score;
      try{ localStorage.setItem('gameScore', String(state.score)); }catch(e){}
      if (state.score > state.bestScore){
        state.bestScore = state.score;
        if (bestScoreEl) bestScoreEl.textContent = state.bestScore;
        try{ localStorage.setItem('gameBestScore', String(state.bestScore)); }catch(e){}
      }
      updatePlayerScore(); // Update player score and leaderboard
      if (state.score && state.score % 150 === 0){
        state.level += 1;
        levelEl.textContent = state.level;
        Sound.play('level');
        const completedLevels = Math.floor(state.score / 150);
        const tt = tmap[document.documentElement.lang] || tmap.fa;
        showToast(`${tt.levelUpMsg} ${state.level}`, 'level');
        if (state.level % 5 === 0 && !boss){ enemies.length = 0; spawnBoss(); }
      }
    }
    let _hurtTimer = null;
    function showHurtOverlay(){
      if (!hurtOverlay) return;
      hurtOverlay.classList.add('show');
      hurtOverlay.setAttribute('aria-hidden','false');
      // Update hurt overlay to show remaining lives
      hurtOverlay.innerHTML = `💔<br><span style="font-size: 0.8em; color: #fff;">${Math.max(0, state.lives)}</span>`;
      if (_hurtTimer) clearTimeout(_hurtTimer);
      _hurtTimer = setTimeout(()=>{
        hurtOverlay.classList.remove('show');
        hurtOverlay.setAttribute('aria-hidden','true');
        hurtOverlay.innerHTML = '💔'; // Reset to default
      }, 2000);
    }
    function earnCoins(n){ state.coins += n; coinsEl.textContent = state.coins; try{ localStorage.setItem('gameCoins', String(state.coins)); }catch(e){} Sound.play('coin'); }
    function damage(){ state.lives -= 1; livesEl.textContent = Math.max(0, state.lives); showHurtOverlay(); Sound.play('hurt'); shake = 8; if (state.lives <= 0) gameOver(); }
    function gameOver(){ 
      running = false; 
      Sound.play('boom'); 
      stopDiamondRain(); // Stop diamond rain when game over
      // Update final stats
      if (finalScoreEl) finalScoreEl.textContent = state.score;
      if (finalBestEl) finalBestEl.textContent = state.bestScore;
      // Show modal
      gameOverModal.classList.add('active');
      gameOverModal.setAttribute('aria-hidden','false');
    }

    function updateParticles(){
      for (let i=particles.length-1;i>=0;i--){
        const p = particles[i];
        p.x += p.vx; 
        p.y += p.vy; 
        p.vy += 0.06; 
        p.life -= 1;
        if (p.life<=0) particles.splice(i,1);
      }
    }

    function updatePlayer(){
      const targetY = Math.min(H-60, Math.max(H*0.55, mouseY));
      player.x += (mouseX - player.x) * 0.18;
      player.y += (targetY - player.y) * 0.12;
      recoil = Math.max(0, recoil - 0.9);
    }

    function updateBullets(){
      const spd = slowMo > 0 ? 0.5 : 1;
      for (let i=bullets.length-1;i>=0;i--){
        const b = bullets[i]; b.y += b.vy*spd; if (b.vx) b.x += b.vx*spd; b.life = (b.life||90)-1; if (b.y < -20 || b.life<=0) bullets.splice(i,1);
      }
    }

    function updateEnemies(){
      const spd = slowMo > 0 ? 0.5 : 1;
      
      // Only spawn regular enemies if no boss
      if (!boss && state.time % Math.max(34 - state.level*3, 12) === 0) spawnEnemy();
      
      for (let i=enemies.length-1;i>=0;i--){
        const e = enemies[i]; 
        e.y += e.vy*spd; 
        e.t += 1; 
        e.x += Math.sin(e.t*0.05) * 1.1;
        if (e.y - e.r > H+30){ 
          enemies.splice(i,1); 
          damage(); 
          combo = 0; 
        }
      }
      
      if (boss){
        boss.t += 1; 
        boss.x += boss.vx*spd; 
        if (boss.x < boss.r || boss.x > W-boss.r) boss.vx *= -1;
        boss.shootTimer -= 1; 
        if (boss.shootTimer <= 0){ 
          boss.shootTimer = 80; 
          enemies.push({x: boss.x, y: boss.y+boss.r, r: 16, vy: 2*spd, hp: 1, t: 0, elite: false}); 
        }
        if (boss.hp <= 0){ 
          boss = null; 
          earnCoins(50); 
          score(500); 
          shake = 12; 
          addParticles(W/2, 80, '#fde047'); 
          Sound.play('boom');
          // Clear remaining enemies after boss defeat
          enemies.length = 0;
          // Continue to next level
          state.level += 1;
          levelEl.textContent = state.level;
          Sound.play('level');
          showToast((tmap[document.documentElement.lang]||tmap.fa).levelUpMsg + ' ' + state.level, 'level');
        }
      }
    }
    function updatePowerups(){
      const spd = slowMo > 0 ? 0.5 : 1;
      for (let i=powerups.length-1;i>=0;i--){
        const p = powerups[i]; p.y += p.vy*spd; p.t += 1;
        if (p.y - p.r > H+30) powerups.splice(i,1);
      }
      if (comboTimer > 0) comboTimer -= 1; else if (combo > 0) combo = 0;
      if (shield > 0) shield -= 1;
      if (tripleShot > 0) tripleShot -= 1;
      if (magnet > 0) magnet -= 1;
      if (slowMo > 0) slowMo -= 1;
    }

    function collide(){
      // bullet-enemy
      for (let i=enemies.length-1;i>=0;i--){
        const e = enemies[i];
        for (let j=bullets.length-1;j>=0;j--){
          const b = bullets[j];
          const dx = e.x - b.x, dy = e.y - b.y; 
          if (dx*dx + dy*dy <= (e.r + b.r)*(e.r + b.r)){
            bullets.splice(j,1); e.hp -= 2; addParticles(b.x,b.y,'#fca5a5'); Sound.playAt('hit', (e.x/W)*2 - 1);
            if (e.hp<=0){
              enemies.splice(i,1);
              combo += 1; comboTimer = 120;
              const mult = Math.min(5, 1 + Math.floor(combo/5)*0.5);
              score(Math.floor((10 + (e.elite?10:0))*mult));
              earnCoins(2 + (e.elite?2:0));
              addParticles(b.x,b.y,'#fde68a'); addParticles(b.x+4,b.y+2,'#f59e0b'); addParticles(b.x-3,b.y-1,'#ef4444');
              rings.push({x:b.x,y:b.y,r:2,max:46,a:0.55,color: e.elite?'rgba(245,158,11,':'rgba(239,68,68,'});
              if (Math.random() < 0.12) spawnPowerup(b.x, b.y);
              if (combo % 10 === 0 && combo > 0){ shake += 4; addParticles(W/2, H/2, '#fde047'); Sound.play('level'); slowMo = 60; }
              break;
            }
          }
        }
      }
      // bullet-boss
      if (boss){
        for (let j=bullets.length-1;j>=0;j--){
          const b = bullets[j];
          const dx = boss.x - b.x, dy = boss.y - b.y; if (dx*dx + dy*dy <= (boss.r + b.r)*(boss.r + b.r)){
            bullets.splice(j,1); boss.hp -= 2; addParticles(b.x,b.y,'#fca5a5'); Sound.playAt('hit', (boss.x/W)*2 - 1); shake += 1;
          }
        }
      }
      // enemy-player
      for (let i=enemies.length-1;i>=0;i--){
        const e = enemies[i];
        const dx = e.x - player.x, dy = e.y - player.y; if (dx*dx + dy*dy <= (e.r + player.r)*(e.r + player.r)){
          enemies.splice(i,1); addParticles(player.x,player.y,'#93c5fd');
          if (shield > 0){ shield = 0; Sound.play('deny'); } else { damage(); combo = 0; }
        }
      }
      // powerup-player
      for (let i=powerups.length-1;i>=0;i--){
        const p = powerups[i];
        const dx = p.x - player.x, dy = p.y - player.y;
        if (magnet > 0 && Math.sqrt(dx*dx + dy*dy) < 120){ p.x += (player.x - p.x)*0.08; p.y += (player.y - p.y)*0.08; }
        if (dx*dx + dy*dy <= (p.r + player.r)*(p.r + player.r)){
          powerups.splice(i,1);
          if (p.type==='shield'){ shield = 300; showToast((tmap[document.documentElement.lang]||tmap.fa).shieldMsg,'power'); }
          else if (p.type==='triple'){ tripleShot = 400; showToast((tmap[document.documentElement.lang]||tmap.fa).tripleMsg,'power'); }
          else if (p.type==='magnet'){ magnet = 500; showToast((tmap[document.documentElement.lang]||tmap.fa).magnetMsg,'power'); }
          Sound.play('power'); addParticles(p.x, p.y, '#10b981');
        }
      }
    }

    // Adaptive FPS settings
    let lastFrameTime = 0;
    let targetFPS = 120; // Default target FPS
    let frameInterval = 1000 / targetFPS;
    let frameCount = 0;
    let lastFpsUpdate = 0;
    let currentFPS = 0;
    
    // Function to update FPS counter
    function updateFPS(timestamp) {
      frameCount++;
      if (timestamp - lastFpsUpdate >= 1000) {
        currentFPS = Math.round((frameCount * 1000) / (timestamp - lastFpsUpdate));
        frameCount = 0;
        lastFpsUpdate = timestamp;
        
        // Set FPS to 120 for all devices
        targetFPS = 120;
        frameInterval = 1000 / 120;
      }
    }
    
    // Store original functions
    const originalResize = resizeCanvas;
    
    function loop(timestamp) {
      if (!running) return;
      
      // Update FPS counter and check for adaptive adjustments
      updateFPS(timestamp);
      
      // Frame limiting with adaptive FPS
      if (timestamp - lastFrameTime < frameInterval) {
        requestAnimationFrame(loop);
        return;
      }
      
      lastFrameTime = timestamp;
      now = performance.now();
      
      try {
        // Update game state
        if (_perfCount < 120){ _perfSum += (now - (_lastFrameTs||now)); _perfCount++; } else { _perfSum = (now - _lastFrameTs); _perfCount = 1; }
        state.time += 1;
        checkTimeBonus(); // Check for time bonus
        updatePlayer(); updateBullets(); updateEnemies(); updatePowerups(); collide(); updateParticles(); updateRings(); updateDiamonds();
        // draw with subtle screen shake
        ctx.save(); ctx.translate((Math.random()-0.5)*shake, (Math.random()-0.5)*shake);
        drawBG(); drawEnemies(); drawPowerups(); drawBullets(); drawPlayer();
        if (!perfLow || (state.time % 2 === 0)) { drawParticles(); }
        if (!perfLow || (state.time % 3 === 0)) { drawRings(); }
        drawHUD();
        // Slow-mo overlay
        if (slowMo > 0){ ctx.fillStyle = `rgba(59,130,246,${0.15*Math.sin(state.time*0.3)})`; ctx.fillRect(0,0,W,H); }
        ctx.restore();
        shake *= 0.88;
        if (muzzle>0) muzzle -= 1;
        requestAnimationFrame(loop);
        // toggle perfLow based on avg frame time ~ every second
        if (state.time % 60 === 0){ const avg = (_perfSum/_perfCount)||0; if (avg > 28) perfLow = true; else if (avg < 20) perfLow = false; }
      } catch (error) {
        console.error('Game loop error:', error);
        // Continue running even if there's an error
        requestAnimationFrame(loop);
      }
    }

    // Mobile optimizations are now handled in the FPS settings section
    
    // auto start on desktop click
    canvas.addEventListener('mousedown', () => { if (!running) startGame(); });
    document.addEventListener('keydown', (e)=>{ if (e.key==='Enter'){ startGame(); } });

    // Initialize player system
    loadPlayers();
    
    // Check for stored player and update UI
    if (hasStoredPlayer()) {
      const storedName = getStoredPlayerName();
      playerNameDisplay.textContent = storedName;
      playerScoreDisplay.textContent = `${(tmap[document.documentElement.lang] || tmap.fa).scoreText}: 0`;
      if (diamondsEl) diamondsEl.textContent = state.diamonds;
      updatePlayerLevel(state.bestScore);
    }
    
    // Name modal event listeners
    submitNameBtn.addEventListener('click', submitPlayerName);
    nameInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        submitPlayerName();
      }
    });

    // Persistence
    (function restore(){
      try{ const s = parseInt(localStorage.getItem('gameScore')||'0',10); if(!isNaN(s)) state.score = s; }catch(e){}
      try{ const c = parseInt(localStorage.getItem('gameCoins')||'0',10); if(!isNaN(c)) state.coins = c; }catch(e){}
      try{ const d = parseInt(localStorage.getItem('gameDiamonds')||'0',10); if(!isNaN(d)) state.diamonds = d; }catch(e){}
      try{ const b = parseInt(localStorage.getItem('gameBestScore')||'0',10); if(!isNaN(b)) state.bestScore = b; }catch(e){}
      try{ const lbt = parseInt(localStorage.getItem('lastBonusTime')||'0',10); if(!isNaN(lbt) && lbt > 0) lastBonusTime = lbt; }catch(e){}
      // Load saved level based on best score
      try{ const l = parseInt(localStorage.getItem('playerLevel')||'1',10); if(!isNaN(l)) state.level = l; }catch(e){}
      // Load used codes
      try{ 
        const used = localStorage.getItem('usedCodes');
        if (used) {
          const usedCodes = JSON.parse(used);
          // Update validCodes with used status
          Object.keys(usedCodes).forEach(code => {
            if (validCodes.hasOwnProperty(code)) {
              validCodes[code] = usedCodes[code];
            }
          });
        }
      }catch(e){}
      // Update HUD and texts
      scoreEl.textContent = state.score; livesEl.textContent = state.lives; levelEl.textContent = state.level; coinsEl.textContent = state.coins;
      if (bestScoreEl) bestScoreEl.textContent = state.bestScore;
      applyLangGame();
    })();

    function saveSkins(){ 
      try{
        localStorage.setItem('unlockedSkins', JSON.stringify(unlockedSkins));
        localStorage.setItem('selectedSkin', selectedSkin);
      }catch(e){}
    }

    // Auto-pause when opening modals
    function showContinueIndicator() {
      if (running) {
        togglePause();
      }
    }

    // Shop logic (skins only)
    function openShop(){
      renderShop();
      if (coinsShopEl) coinsShopEl.textContent = state.coins;
      shopOverlay.classList.add('active');
      shopOverlay.setAttribute('aria-hidden','false');
      // Hide player info box when entering shop
      if (playerInfo) playerInfo.style.display = 'none';
      Sound.play('shop');
      showContinueIndicator();
    }
    function closeShop(){
      shopOverlay.classList.remove('active');
      shopOverlay.setAttribute('aria-hidden','true');
      // Show player info box when exiting shop
      if (playerInfo) playerInfo.style.display = 'flex';
      // Resume the game if it was paused
      if (!running && started) {
        togglePause();
      }
    }
    function renderShop(){
      shopGrid.innerHTML = '';
      const tt = tmap[document.documentElement.lang] || tmap.fa;

      // Coin packages section (moved to top)
      const coinSection = document.createElement('div');
      coinSection.className = 'shop-section';
      coinSection.style.gridColumn = '1 / -1';
      const coinSectionTitle = document.createElement('div');
      coinSectionTitle.className = 'shop-section-title';
      coinSectionTitle.textContent = tt.coinPackagesTitle || '💰 بسته‌های سکه';
      coinSection.appendChild(coinSectionTitle);
      shopGrid.appendChild(coinSection);

      const coinPackages = [
        { id: 'small', name: (tmap[document.documentElement.lang] || tmap.fa).smallPackage, coins: 300, price: '10,000 تومان' },
        { id: 'medium', name: (tmap[document.documentElement.lang] || tmap.fa).mediumPackage, coins: 700, price: '20,000 تومان' },
        { id: 'large', name: (tmap[document.documentElement.lang] || tmap.fa).largePackage, coins: 2000, price: '50,000 تومان' },
        { id: 'mega', name: (tmap[document.documentElement.lang] || tmap.fa).megaPackage, coins: 5000, price: '100,000 تومان' },
        { id: 'ultra', name: (tmap[document.documentElement.lang] || tmap.fa).ultraPackage, coins: 10000, price: '200,000 تومان', discount: '170,000 تومان' },
        { id: 'diamond', name: (tmap[document.documentElement.lang] || tmap.fa).buyDiamonds, diamonds: 500, price: '100,000 تومان' }
      ];

      coinPackages.forEach(pkg => {
        const item = document.createElement('div');
        item.className = 'shop-item';
        let priceDisplay = pkg.price;
        if (pkg.discount) {
          priceDisplay = `<span style="text-decoration: line-through; opacity:0.7; font-size:0.8rem;">${pkg.price}</span><br><span style="color: #dc2626; font-weight:700;">${pkg.discount}</span>`;
        } else {
          priceDisplay = `<span style="color: #22c55e; font-weight:700;">${pkg.price}</span>`;
        }
        
        let packageIcon = '🪙';
        let packageContent = `${pkg.coins} سکه`;
        if (pkg.diamonds) {
          packageIcon = '💎';
          packageContent = `${pkg.diamonds} الماس`;
        }
        
        let coinIcon = '🪙';
        if (pkg.id === 'ultra') {
          coinIcon = '💎'; // Special icon for ultra package
        } else if (pkg.id === 'diamond') {
          coinIcon = '💎'; // Special icon for diamond package
        }
        
        item.innerHTML = `
          <div class="skin-color" style="background:linear-gradient(135deg, #fbbf24, #f59e0b); position:relative;">
            <span style="font-size:24px; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); text-shadow:0 0 4px rgba(0,0,0,0.3);">${coinIcon}</span>
          </div>
          <div class="skin-name">${pkg.name}</div>
          <div class="skin-price">${priceDisplay}</div>
          <div class="skin-actions">
            <button class="btn buy-coins" data-id="${pkg.id}">${tt.buyPackage || 'خرید'}</button>
          </div>
        `;
        shopGrid.appendChild(item);
      });

      // Skins section
      const skinSection = document.createElement('div');
      skinSection.className = 'shop-section';
      skinSection.style.gridColumn = '1 / -1';
      skinSection.innerHTML = `<div class="shop-section-title">${tt.shopTitle}</div>`;
      shopGrid.appendChild(skinSection);

      const sortedSkins = [...skins].sort((a, b) => {
        const aOwned = unlockedSkins[a.id] ? 1 : 0;
        const bOwned = unlockedSkins[b.id] ? 1 : 0;
        if (aOwned !== bOwned) return bOwned - aOwned;
        return (a.price||0) - (b.price||0);
      });

      sortedSkins.forEach(skin => {
        const item = document.createElement('div');
        item.className = 'shop-item';
        const owned = unlockedSkins[skin.id];
        const isSel = selectedSkin === skin.id;
        item.innerHTML = `
          <div class="skin-color${skin.shape ? ' ' + skin.shape : ''}" style="background:${skin.color}; position:relative;">
            <span style="font-size:20px; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); text-shadow:0 0 4px rgba(0,0,0,0.3);">${skin.name.match(/[\U0001F300-\U0001F5FF\U0001F600-\U0001F64F\U0001F680-\U0001F6FF\U0001F700-\U0001F77F\U0001F780-\U0001F7FF\U0001F800-\U0001F8FF\U0001F900-\U0001F9FF\U0001FA00-\U0001FA6F\U0001FA70-\U0001FAFF\U00002702-\U000027B0\U000024C2-\U0001F251]/g) ? skin.name.match(/[\U0001F300-\U0001F5FF\U0001F600-\U0001F64F\U0001F680-\U0001F6FF\U0001F700-\U0001F77F\U0001F780-\U0001F7FF\U0001F800-\U0001F8FF\U0001F900-\U0001F9FF\U0001FA00-\U0001FA6F\U0001FA70-\U0001FAFF\U00002702-\U000027B0\U000024C2-\U0001F251]/g)[0] || '👤' : '👤'}</span>
          </div>
          <div class="skin-name">${skin.name}</div>
          <div class="skin-price">${skin.currency === 'diamonds' ? `💎 ${skin.price}` : `🪙 ${skin.price}`}</div>
          <div class="skin-actions">
            ${owned ? `<button class="btn select" data-id="${skin.id}">${isSel ? (tt.selected||'انتخاب شده') : (tt.select||'انتخاب')}</button>` : `<button class="btn buy" data-id="${skin.id}">${tt.buy||'خرید'}</button>`}
          </div>
        `;
        shopGrid.appendChild(item);
      });
    }

    shopGrid.addEventListener('click', (e)=>{
      const buyBtn = e.target.closest('.buy');
      const selBtn = e.target.closest('.select');
      const buyCoinsBtn = e.target.closest('.buy-coins');

      if (buyBtn){
        const id = buyBtn.getAttribute('data-id');
        const skin = skins.find(s=>s.id===id);
        if (!skin) return;
        
        if (skin.currency === 'diamonds') {
          // Diamond purchase
          if (state.diamonds >= skin.price){
            state.diamonds -= skin.price;
            if (diamondsEl) diamondsEl.textContent = state.diamonds;
            unlockedSkins[id] = true;
            selectedSkin = id;
            saveSkins();
            renderShop();
            Sound.play('buy');
            try{ localStorage.setItem('gameDiamonds', String(state.diamonds)); }catch(e){}
          } else {
            Sound.play('deny');
            showToast('الماس کافی ندارید!', 'error');
          }
        } else {
          // Coin purchase
          if (state.coins >= skin.price){
            state.coins -= skin.price;
            coinsEl.textContent = state.coins;
            if (coinsShopEl) coinsShopEl.textContent = state.coins;
            unlockedSkins[id] = true;
            selectedSkin = id;
            saveSkins();
            renderShop();
            Sound.play('buy');
            try{ localStorage.setItem('gameCoins', String(state.coins)); }catch(e){}
          } else {
            Sound.play('deny');
          }
        }
      } else if (selBtn){
        const id = selBtn.getAttribute('data-id');
        if (unlockedSkins[id]){
          selectedSkin = id;
          saveSkins();
          renderShop();
          Sound.play('select');
        }
      } else if (buyCoinsBtn){
        // Show support message for coin purchases
        showToast('برای خرید به ایدی پشتیبان مراجعه کنید', 'error');
        Sound.play('deny');
      }
    });

    // Code modal logic
    function openCodeModal(){ 
      codeInput.value = '';
      codeMessage.textContent = '';
      codeOverlay.classList.add('active'); 
      codeOverlay.setAttribute('aria-hidden','false'); 
      // Hide player info
      const playerInfo = document.getElementById('playerInfo');
      if (playerInfo) playerInfo.style.display = 'none';
      
      Sound.play('shop'); 
      showToast((tmap[document.documentElement.lang]||tmap.fa).codeMsg,''); 
      codeInput.focus();
      showContinueIndicator();
    }
    
    // Show bonus status and give coins if ready
    function showBonusStatus() {
      const tt = tmap[document.documentElement.lang] || tmap.fa;
      const now = Date.now();
      const timeUntilBonus = BONUS_INTERVAL - (now - lastBonusTime);
      const hoursUntilBonus = Math.floor(timeUntilBonus / (1000 * 60 * 60));
      const minutesUntilBonus = Math.floor((timeUntilBonus % (1000 * 60 * 60)) / (1000 * 60));
      
      if (timeUntilBonus <= 0) {
        // Only give coins if the game is already running and the user explicitly clicked the bonus button
        if (started && running) {
          // Give 50 coins immediately
          state.coins += BONUS_COINS;
          lastBonusTime = now;
          
          // Save coins and bonus time
          try { 
            localStorage.setItem('gameCoins', String(state.coins));
            localStorage.setItem('lastBonusTime', String(lastBonusTime)); 
          } catch(e) {}
          
          // Update display
          if (coinsEl) coinsEl.textContent = state.coins;
          
          // Show success message with translation
          const giftReceived = tt.giftReceived || 'هدیه دریافت شد';
          const coinsText = tt.coins || 'سکه';
          showToast(`🎉 ${giftReceived}: ${BONUS_COINS} ${coinsText}!`, 'power');
        } else {
          // If game is not running, just show the time remaining without giving coins
          const startGameMsg = tt.startGameForBonus || 'بازی را شروع کنید تا هدیه زمانی دریافت کنید';
          showToast(`⏰ ${startGameMsg}`, 'power');
        }
      } else {
        // Show time remaining with translation
        const timeRemaining = (tt.timeRemaining || '{hours} ساعت و {minutes} دقیقه تا هدیه بعدی')
          .replace('{hours}', hoursUntilBonus)
          .replace('{minutes}', minutesUntilBonus);
        showToast(`⏰ ${timeRemaining}`, 'power');
      }
    }
    
    function closeCodeModal(){ 
      codeOverlay.classList.remove('active'); 
      codeOverlay.setAttribute('aria-hidden','true'); 
      // Show player info
      const playerInfo = document.getElementById('playerInfo');
      if (playerInfo) playerInfo.style.display = 'flex';
      
      // Resume the game if it was paused
      if (!running && started) {
        togglePause();
      }
    }
    
    function submitCode(){
      const code = codeInput.value.trim().toLowerCase();
      const tt = tmap[document.documentElement.lang] || tmap.fa;
      
      if (!code) {
        codeMessage.textContent = tt.wrongCode;
        codeMessage.style.color = '#ef4444';
        Sound.play('deny');
        return;
      }
      
      // Check if code is valid and not used
      if (validCodes[code]) {
        // Code is valid and not used, award coins
        const coinAmount = validCodes[code].coins || 300;
        validCodes[code] = false; // Mark as used
        earnCoins(coinAmount);
        codeMessage.textContent = `کد صحیح! ${coinAmount} سکه دریافت کردید`;
        codeMessage.style.color = '#10b981';
        Sound.play('coin');
        
        // Save used codes to localStorage
        try {
          localStorage.setItem('usedCodes', JSON.stringify(validCodes));
        } catch(e) {}
        
        // Close modal after 2 seconds
        setTimeout(() => {
          closeCodeModal();
        }, 2000);
      } else {
        // Check if code exists but was already used
        const originalCodes = {
          'mahan': true,
          'game': true,
          'shoti': true
        };
        
        if (originalCodes[code]) {
          codeMessage.textContent = tt.usedCode;
          codeMessage.style.color = '#f59e0b';
        } else {
          codeMessage.textContent = tt.wrongCode;
          codeMessage.style.color = '#ef4444';
        }
        Sound.play('deny');
      }
    }
  })();
