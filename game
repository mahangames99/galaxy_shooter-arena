        background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, rgba(99, 102, 241, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
        transform: translate(-50%, -50%);
        opacity: 0;
      }
    </style>
    <div class="signature-wrapper">
      <div class="signature-inner">
        <div class="logo-container">
          <div class="logo-initials">M</div>
        </div>
        <div class="signature-content">
          <span class="name" id="developerName">محمد ماهان عبدلی</span>
          <span class="title" data-i18n="gameDeveloper">سازنده بازی</span>
        </div>
        <div class="signature-hover-effect" id="hoverEffect"></div>
      </div>
    </div>
    <script>
      // Function to update developer name based on language
      function updateDeveloperName() {
        const nameElement = document.getElementById('developerName');
        if (nameElement) {
          // Check if the current language is English
          if (document.documentElement.lang === 'en') {
            nameElement.textContent = 'Mohammad Mahan Abdoli';
          } else {
            nameElement.textContent = 'محمد ماهان عبدلی';
          }
        }
      }
      
      // Listen for language changes
      window.addEventListener('languageChange', updateDeveloperName);
      
      // Update on page load
      document.addEventListener('DOMContentLoaded', function() {
        // Initial update of developer name
        updateDeveloperName();
        
        // Function to update signature text based on language
        function updateSignatureLanguage() {
          const title = document.querySelector('[data-i18n="game_developer"]');
          if (title && window.tt && window.tt.gameDeveloper) {
            title.textContent = window.tt.gameDeveloper;
          } else if (title) {
            title.textContent = 'سازنده بازی'; // Default text
          }
        }
        
        // Update signature text when language changes
        if (window.addEventListener) {
          window.addEventListener('languageChange', updateSignatureLanguage);
        }
        
        // Initial update
        updateSignatureLanguage();
      });
    </script>
  </div>
  <div class="version-indicator">
    <span id="versionText" data-i18n="versionText">نسخه ۳ (اصلی)</span>
  </div>
</body>
</html>
